# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings → API). See README.md for the
# full setup walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The username + password that unlocks /admin and the approve/reject
# routes (browser's built-in login prompt — no page or sign-up flow
# needed). Pick your own values; these are not defaults that ship
# anywhere. See README.md for how to set these in Vercel.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional. Only fill this in once you have a Google AdSense account
# and it's been approved — see README.md's "Turn on Google AdSense"
# section. Leaving it blank simply means no ads render; nothing else
# breaks.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
